{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.5",
  "private": true,
  "license": "MIT",
  "llamaLicense": "Llama 3.2 Community License — see NOTICE",
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "mcp": "bun mini-services/quorum-mcp/index.ts",
    "db:push": "echo '[db] Quorum uses a JSON file store (db/) — no database to push.'",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "test": "bun test mini-services/quorum-mcp/ src/lib/gate-receipts.test.ts src/lib/quorum-knowledge.test.ts src/lib/quorum-nav.test.ts src/lib/tender-extract.test.ts src/lib/sam.test.ts src/lib/tender-access.test.ts src/lib/audit-export.test.ts src/lib/tender-local-store.test.ts src/lib/supplier-pulse.test.ts src/app/api/public/summary/route.test.ts workers/quorum-edge/http-range.test.ts workers/quorum-edge/worker.test.ts",
    "test:edge": "bash -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; bun test workers/quorum-edge/ \"src/app/api/tenders/[ref]/docs/route.test.ts\"'",
    "desktop:icons": "node scripts/desktop-icons.mjs",
    "desktop:build": "npm run desktop:icons && electron-builder --publish never"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.1.1",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@mdxeditor/editor": "^3.39.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@reactuses/core": "^6.0.5",
    "@tanstack/react-query": "^5.82.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^13.0.0",
    "framer-motion": "^12.23.2",
    "input-otp": "^1.4.2",
    "logrocket": "^12.4.0",
    "lucide-react": "^0.525.0",
    "mammoth": "^1.13.0",
    "next": "^16.1.1",
    "next-auth": "^4.24.11",
    "next-intl": "^4.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.3",
    "react-syntax-highlighter": "^15.6.1",
    "read-excel-file": "^9.3.13",
    "recharts": "^2.15.4",
    "sharp": "^0.34.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "unpdf": "^1.9.1",
    "uuid": "^11.1.0",
    "vaul": "^1.1.2",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "build": {
    "appId": "africa.quorum.desktop",
    "productName": "Quorum",
    "asar": true,
    "directories": {
      "app": "desktop",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "icon": "build/desktop/icon.icns",
      "artifactName": "Quorum-macOS.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/desktop/icon.ico",
      "artifactName": "Quorum-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "Quorum-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "docx": "^9.15.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
