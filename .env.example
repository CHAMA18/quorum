# quorum-mcp agent runtime (optional — copy to .env.local or export in the shell)
#
# Any OpenAI-compatible endpoint. The intended setup is an open-weights model
# served in-region (vLLM, TGI, Ollama, …) so procurement data stays in the
# jurisdiction. WITHOUT these variables nothing breaks: redline drafting runs
# on the deterministic template fallback and every draft is labelled "template".
#
# ─── Meta Global AI Developer Hackathon 2026 — model wiring ─────────────────
#
# Option A (recommended, open weights, in-region) — Llama 3.2 via Ollama.
#   Measured in-repo (numbers in SUBMISSION/10-cost-and-audit.md):
#     ollama pull llama3.2:3b && ollama serve
#     LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.2:3b
#
# Option B (hosted) — Meta Model API (https://dev.meta.ai).
#   The drafting path is OpenAI-compatible: take the chat-completions base URL
#   and model id issued in your Meta developer console and set them here, e.g.
#     LLM_BASE_URL=<your-meta-model-api-base-url>/v1
#     LLM_MODEL=<meta-model-id>
#     LLM_API_KEY=<your-meta-api-token>
#   Nothing else changes — the same graph, tools and gate run unchanged.
#
# Option C (no endpoint) — leave everything empty. The deterministic template
# drafts redlines and labels every draft "template"; the product still boots.

# Base URL of the chat-completions endpoint, e.g. http://localhost:8000/v1
LLM_BASE_URL=

# Model name the endpoint serves, e.g. llama3.2:3b (Ollama) or a Meta Model API model id
LLM_MODEL=

# Bearer token, only if the endpoint requires one
LLM_API_KEY=

# Where the MCP sidecar reads the web app's committee roster from
# (default: http://127.0.0.1:3000)
QUORUM_WEB_URL=http://127.0.0.1:3000
