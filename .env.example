# quorum-mcp agent runtime (optional — copy to .env.local or export in the shell)
#
# The hackathon build leads with Muse Spark 1.3 on Meta Model API and keeps
# Llama 3.2 through Ollama as the in-region fallback. Both speak the same
# OpenAI-compatible chat-completions shape, so the graph, tools and gate run
# unchanged. WITHOUT any of these variables nothing breaks: redline drafting
# runs on the deterministic template fallback and every draft is labelled
# "template".
#
# ─── Meta Global AI Developer Hackathon 2026 — model wiring ─────────────────
#
# Option A (default in the hackathon build) — Muse Spark 1.3, hosted.
#   Base URL: https://api.meta.ai/v1  (api.llama.com was RETIRED 2026-07-06)
#   Auth: Bearer. Surfaces: /v1/chat/completions, /v1/messages, /v1/responses
#     LLM_BASE_URL=https://api.meta.ai/v1
#     LLM_MODEL=muse-spark-1.3
#     LLM_API_KEY=<your-meta-api-token>
#   Muse Spark is a reasoning model: it spends tokens thinking before it
#   answers, so the gateway sends max_tokens: 4096. A 300-token cap returns
#   an empty content string (verified 2026-10-31).
#
# Option B (in-region fallback) — Llama 3.2 via Ollama.
#   Measured in-repo (numbers in SUBMISSION/10-cost-and-audit.md):
#     ollama pull llama3.2:3b && ollama serve
#     LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
#     LLM_FALLBACK_MODEL=llama3.2:3b
#   The fallback runs only when the primary fails or the residency policy
#   refuses the primary. Its drafts keep the full evidence on the desk.
#
# ─── Residency and redaction ───────────────────────────────────────────────
#   MODEL_RESIDENCY=IN_REGION | HOSTED | HYBRID      (default IN_REGION)
#     IN_REGION refuses any endpoint outside localhost/private networks.
#     HOSTED    allows a hosted provider (the operator has approved it).
#     HYBRID    allows the hosted primary with the in-region fallback.
#   MODEL_REDACTION=on | off                          (default on)
#     Hosted calls redact supplier names and currency amounts before they
#     leave the desk. `off` is honoured only with MODEL_REDACTION_EXPLICIT=
#     "I ACCEPT" — a deliberate, written acknowledgement.
#
#   The hackathon demo runs MODEL_RESIDENCY=HYBRID so Muse Spark plans and
#   drafts from redacted evidence, and Llama 3.2 can answer in-region with
#   the full pack if the hosted call fails.
#
#   DIAGNOSTIC NOTE (2026-10-27, verified across two keys/account scopes):
#   a key that gets HTTP 200 on GET /v1/models with an EMPTY data[] is
#   authenticated but has ZERO model entitlements. Credits (billing) are not
#   the same as model-access grants. The fix is console-side: regenerate the
#   key AFTER entitlement activation, and take the exact model id from the
#   console playground's curl example. Probe without wiring anything:
#     bash scripts/verify-llama-api.sh https://api.meta.ai/v1 <model-id> <key>
#   (writes a masked judge-facing receipt on success; nothing on failure)
#
# Option C (no endpoint) — leave everything empty. The deterministic template
# drafts redlines and labels every draft "template"; the product still boots.

# ─── SAM 3.1 — scanned-page region locator (opt-in) ───────────────────────
# When a PDF has no embedded text (a scan) or an image is uploaded, SAM 3.1
# locates the table region so a human can inspect the price schedule. It does
# NOT read text or authenticate a signature; the upload is always marked
# `humanReviewRequired`. The page image leaves the deployment, so the call is
# off unless SAM_ENABLED is exactly "true". PDF rendering uses Poppler
# (`pdftoppm`), the same dependency the OCR fallback already needs.
#   SAM_ENABLED=true
#   SAM_MODEL=sam-3.1
#   SAM_PROMPT=table
#   SAM_BASE_URL=https://api.meta.ai/v1   (defaults to MUSE_BASE_URL/LLM_BASE_URL)
#   SAM_API_KEY=                          (defaults to MUSE_API_KEY/LLM_API_KEY)
SAM_ENABLED=

# ─── Desk assistant (voice chat bubble) — Muse ────────────────────────────
# The floating bubble on every screen is powered by Meta Model API:
#   Muse Spark answers (chat + read-only desk tools),
#   Muse Voice Transcribe hears the mic button.
# With no key set, the bubble still appears and says so; typing falls back to
# the setup notice. Nothing else in the product changes.
#
#   MUSE_API_KEY=<your-meta-api-token>      (falls back to LLM_API_KEY below)
#   MUSE_BASE_URL=https://api.meta.ai/v1    (default)
#   MUSE_MODEL=muse-spark-1.3               (default)
#   MUSE_VOICE_MODEL=muse-voice-transcribe-1.0  (default)
#
# Set only these two to enable the assistant on the hosted Meta stack:
#   MUSE_API_KEY=   MUSE_MODEL=
# Leave them empty to keep the assistant off (it shows the setup line).
MUSE_API_KEY=
MUSE_MODEL=

# ─── Real voice (Cloudflare Workers AI) ────────────────────────────────────
# The mic uses Muse Voice Transcribe. Spoken replies use Deepgram Aura-2 via
# the quorum-edge Worker (MeloTTS fallback, then the browser's own voice).
# Keep the shared secret server-side; never expose it to the client.
#   QUORUM_EDGE_URL=https://quorum-edge.chungu424.workers.dev
#   QUORUM_EDGE_SECRET=<the EDGE_SHARED_SECRET installed with wrangler>
QUORUM_EDGE_URL=
QUORUM_EDGE_SECRET=
MCP_REMOTE_TOKEN=

# ─── Signed tender-document downloads ─────────────────────────────────────
# Optional. Signs five-minute download URLs bound to the tender object key,
# expiry and signed-in user. Falls back to GATE_SECRET when empty; in
# production one of the two must be a real secret. Keep it server-side.
QUORUM_DOWNLOAD_SECRET=

# Base URL of the chat-completions endpoint, e.g. https://api.meta.ai/v1
LLM_BASE_URL=

# Model name the endpoint serves, e.g. muse-spark-1.3 (Meta) or llama3.2:3b (Ollama)
LLM_MODEL=

# Bearer token, only if the endpoint requires one
LLM_API_KEY=

# In-region fallback, tried only when the primary fails or is refused by the
# residency policy. Leave empty for a single-endpoint deployment.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# IN_REGION (default) | HOSTED | HYBRID — where procurement evidence may go.
MODEL_RESIDENCY=
# on (default) | off — hosted calls redact supplier names and amounts.
MODEL_REDACTION=
# Required, in these words, before MODEL_REDACTION=off is honoured.
MODEL_REDACTION_EXPLICIT=

# Where the MCP sidecar reads the web app's committee roster from
# (default: http://127.0.0.1:3000)
QUORUM_WEB_URL=http://127.0.0.1:3000

# ─── OCP Data Registry refresh ─────────────────────────────────────────────
# The sidecar refreshes the registry snapshots automatically. It checks once
# an hour and runs the miner (mine-ocp-africa.py) only when the snapshot is
# older than OCP_REFRESH_DAYS. A failure keeps the last good snapshot.
OCP_REFRESH_ENABLED=true
OCP_REFRESH_DAYS=7
# OCP_REFRESH_CHECK_MINUTES=60
# PYTHON=python3
