#
# quorum-mcp agent runtime (optional — copy to .env.local or export in the shell)
#
# The app leads with Kira, Quorum's open-weight model, served through an
# OpenAI-compatible endpoint. The local default is Llama 3.2 3B on Ollama.
# A customized or hosted open-weight model is selected with KIRA_*; the
# legacy LLM_* variables remain for existing deployments. WITHOUT a reachable
# endpoint nothing breaks: the assistant uses its deterministic local brain
# and redline drafting uses the template fallback.
#
# ─── Kira — open-weight model wiring ─────────────────────────────────────────
#
# Option A (default) — Kira on local Ollama.
#     KIRA_BASE_URL=http://localhost:11434/v1
#     KIRA_MODEL=llama3.2:3b
#     KIRA_API_KEY=
#   This is a real open-weight model with native tool calls. It keeps
#   procurement text in-region and needs no hosted credential.
#
# Option B (customized or hosted open weights) — point Kira at your own
# OpenAI-compatible endpoint and exact model id:
#     KIRA_BASE_URL=https://your-kira-endpoint/v1
#     KIRA_API_KEY=<provider-token-if-required>
#     KIRA_MODEL=<your-model-id>
#   KIRA_* wins over LLM_* for chat and review drafting.
#
# Option C (Cloudflare) — Kira served by the quorum-edge Worker on Workers AI
# (Llama 3.2 3B, @cf/meta/llama-3.2-3b-instruct). The Worker accepts
# EDGE_SHARED_SECRET as the bearer token. Cloudflare is a hosted network, so
# this needs MODEL_RESIDENCY=HOSTED or HYBRID.
#     KIRA_BASE_URL=https://quorum-edge.chungu424.workers.dev/v1
#     KIRA_MODEL=@cf/meta/llama-3.2-3b-instruct
#     KIRA_API_KEY=<EDGE_SHARED_SECRET>
#   The endpoint answers chat completions as plain text: it does not stream
#   and does not emit tool calls, so a tool loop still needs a tool-capable
#   Kira endpoint. Verified 2026-11-16: reachable, ~0.7s warm, valid JSON for
#   the Tender Builder prompt. Limits and Render wiring: docs/MODEL-HOSTING.md.
#   Check any endpoint with `npm run kira:check`.
#
# Option D (in-region fallback) — a second Llama endpoint, tried only when the
# primary fails or the residency policy refuses it.
#     LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
#     LLM_FALLBACK_MODEL=llama3.2:3b
#
# ─── Residency and redaction ───────────────────────────────────────────────
#   MODEL_RESIDENCY=IN_REGION | HOSTED | HYBRID      (default IN_REGION)
#     IN_REGION refuses any endpoint outside localhost/private networks.
#     HOSTED    allows a hosted provider (the operator has approved it).
#     HYBRID    allows the hosted primary with the in-region fallback.
#   MODEL_REDACTION=on | off                          (default on)
#     Hosted calls redact supplier names and currency amounts before they
#     leave the desk. `off` is honoured only with MODEL_REDACTION_EXPLICIT=
#     "I ACCEPT" — a deliberate, written acknowledgement.
#
#   Local Kira is in-region, so it can see the full pack. Set HYBRID only
#   when a hosted Kira or fallback endpoint is also configured.
#
#   DIAGNOSTIC NOTE (2026-10-27, verified across two keys/account scopes):
#   a key that gets HTTP 200 on GET /v1/models with an EMPTY data[] is
#   authenticated but has ZERO model entitlements. Credits (billing) are not
#   the same as model-access grants. The fix is console-side: regenerate the
#   key AFTER entitlement activation, and take the exact model id from the
#   console playground's curl example. Probe without wiring anything:
#     bash scripts/verify-llama-api.sh https://api.meta.ai/v1 <model-id> <key>
#   (writes a masked judge-facing receipt on success; nothing on failure)
#
# Option D (no endpoint) — leave everything empty. The deterministic template
# drafts redlines and labels every draft "template"; the product still boots.

# ─── Store encryption key ──────────────────────────────────────────────────
# TOTP secrets are encrypted at rest. Leave empty to generate a 0600 key at
# db/.totp-key; set a stable 32-byte key (64 hex chars or base64) in production
# and back it up with the store. Losing it invalidates existing enrolments.
QUORUM_STORE_KEY=

# ─── Workspace registration ─────────────────────────────────────────────────
# Single-workspace mode is the pilot default. The first account opens the
# workspace; every later account needs an invitation into it. Set this to
# false only for a hosted multi-tenant deployment whose store is tenant-scoped.
QUORUM_SINGLE_WORKSPACE=true

# ─── SAM 3.1 — scanned-page region locator (opt-in) ───────────────────────
# When a PDF has no embedded text (a scan) or an image is uploaded, SAM 3.1
# locates the table region so a human can inspect the price schedule. It does
# NOT read text or authenticate a signature; the upload is always marked
# `humanReviewRequired`. The page image leaves the deployment, so the call is
# off unless SAM_ENABLED is exactly "true". PDF rendering uses Poppler
# (`pdftoppm`), the same dependency the OCR fallback already needs.
#   SAM_ENABLED=true
#   SAM_MODEL=sam-3.1
#   SAM_PROMPT=table
#   SAM_BASE_URL=https://api.meta.ai/v1   (defaults to LLM_BASE_URL)
#   SAM_API_KEY=                          (defaults to LLM_API_KEY)
SAM_ENABLED=

# ─── Desk assistant (chat bubble) ─────────────────────────────────────────
# Kira answers the chat and runs the read-only desk tools. Kira's endpoint is
# configured by the KIRA_* block above (or the legacy LLM_* pair).
#
#   KIRA_REASONING_EFFORT=medium              (minimal|low|medium|high; forwarded when supported)
#   ASSISTANT_SAFETY_IDENTIFIER_SECRET=<stable private key> (optional keyed user pseudonyms)
KIRA_BASE_URL=http://localhost:11434/v1
KIRA_MODEL=llama3.2:3b
KIRA_API_KEY=

# ─── Real voice (Cloudflare Workers AI) ────────────────────────────────────
# The mic uses speech-to-text at the quorum-edge Worker (whisper → nova-3),
# falling back to the browser's own recognition. Spoken replies use Deepgram
# Aura-2 via the same Worker (MeloTTS fallback, then the browser's voice).
# Keep the shared secret server-side; never expose it to the client.
#   QUORUM_EDGE_URL=https://quorum-edge.chungu424.workers.dev
#   QUORUM_EDGE_SECRET=<the EDGE_SHARED_SECRET installed with wrangler>
QUORUM_EDGE_URL=
QUORUM_EDGE_SECRET=
MCP_REMOTE_TOKEN=

# Distributed limits for authenticated API writes (Upstash Redis REST).
# The requisition-validation endpoint refuses writes if either value is missing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Signed tender-document downloads ─────────────────────────────────────
# Optional. Signs five-minute download URLs bound to the tender object key,
# expiry and signed-in user. Falls back to GATE_SECRET when empty; in
# production one of the two must be a real secret. Keep it server-side.
QUORUM_DOWNLOAD_SECRET=

# Base URL of the chat-completions endpoint, e.g. https://api.meta.ai/v1
LLM_BASE_URL=

# Legacy explicit endpoint/model. Kira prefers KIRA_BASE_URL/KIRA_MODEL above.
# Example: llama3.2:3b (Ollama) or your hosted open-weight model id.
LLM_MODEL=

# Bearer token, only if the endpoint requires one
LLM_API_KEY=

# In-region fallback, tried only when the primary fails or is refused by the
# residency policy. Leave empty for a single-endpoint deployment.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# IN_REGION (default) | HOSTED | HYBRID — where procurement evidence may go.
MODEL_RESIDENCY=
# on (default) | off — hosted calls redact supplier names and amounts.
MODEL_REDACTION=
# Required, in these words, before MODEL_REDACTION=off is honoured.
MODEL_REDACTION_EXPLICIT=
# Optional task-specific Kira reasoning budgets (minimal|low|medium|high; Meta Responses only).
MODEL_REASONING_EFFORT=
MODEL_REASONING_PLAN_REVIEW=
MODEL_REASONING_EVIDENCE_REVIEW=
MODEL_REASONING_DRAFT_REDLINE=
MODEL_REASONING_REPAIR=

# Where the MCP sidecar reads the web app's committee roster from
# (default: http://127.0.0.1:3000)
QUORUM_WEB_URL=http://127.0.0.1:3000

# ─── OCP Data Registry refresh ─────────────────────────────────────────────
# The sidecar refreshes the registry snapshots automatically. It checks once
# an hour and runs the miner (mine-ocp-africa.py) only when the snapshot is
# older than OCP_REFRESH_DAYS. A failure keeps the last good snapshot.
OCP_REFRESH_ENABLED=true
OCP_REFRESH_DAYS=7
# OCP_REFRESH_CHECK_MINUTES=60
# PYTHON=python3

# ─── Napster Omniagent API (optional, server-only) ────────────────────────
# Diagnostics: GET /api/integrations/napster lists companions; POST probes
# whether the key can start a text session (owners and admins). "Speak to
# the desk agent" uses a server-minted text session. The key is project-scoped and
# grants write access to companions, agents, knowledge and tools when used
# directly — keep it server-side and never prefix it with NEXT_PUBLIC_.
# Session access needs an active Napster subscription. See
# docs/napster-integration.md.
NAPSTER_API_KEY=
# Prefer an Omniagent; otherwise a companion connection is used.
# NAPSTER_AGENT_ID=
NAPSTER_COMPANION_ID=
# NAPSTER_VOICE_ID=alloy
# NAPSTER_TIMEOUT_MS=10000

# ─── PostgreSQL — the workspace's system of record ───────────────────────────
#
# Accounts, sessions, the workspace document, the sidecar's run state and its
# job queue live here. Without DATABASE_URL the app runs on its local files
# (development and unit tests) and /api/health reports persistence=file.
#
#   DATABASE_URL=postgres://quorum:secret@localhost:5432/quorum
#   DATABASE_SSL=require              # hosted providers; also inferred from sslmode=
#   DATABASE_SSL_REJECT_UNAUTHORIZED=true
#
# Migrate an existing file store once:
#   bun scripts/migrate-store-to-postgres.ts

# ─── Google sign-in (optional, direct OAuth 2.0) ────────────────────────────
#
# Register the deployment as an OAuth client and add
# ${origin}/api/auth/google/callback as an authorised redirect URI.
#
#   GOOGLE_CLIENT_ID=...
#   GOOGLE_CLIENT_SECRET=...
#   GOOGLE_REDIRECT_URI=https://your-deployment.example/api/auth/google/callback

# ─── WhatsApp Business alerts (optional) ────────────────────────────────────
#
# Gate/deadline alerts go out as an approved WhatsApp template with a desk
# deep link. Approvals never happen over WhatsApp. Until all three of
# WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_TEMPLATE_NAME are
# set, sends are logged SKIPPED in the delivery log — never silent.
#
#   WHATSAPP_TOKEN=                    # permanent token of the Meta app
#   WHATSAPP_PHONE_NUMBER_ID=          # sender phone-number ID (not the number)
#   WHATSAPP_TEMPLATE_NAME=quorum_alert # approved template (see docs/WHATSAPP-INTEGRATION.md)
#   WHATSAPP_TEMPLATE_LANGUAGE=en
#   WHATSAPP_VERIFY_TOKEN=             # webhook subscription handshake
#   WHATSAPP_APP_SECRET=               # verifies X-Hub-Signature-256 on webhook POSTs
#
# Webhook URL: ${origin}/api/whatsapp/webhook

# ─── Slack team-channel alerts (optional) ───────────────────────────────────
#
# Gate/deadline alerts are posted once per event to one shared Slack
# channel with a desk deep link. Approvals never happen in Slack. Until
# SLACK_BOT_TOKEN + SLACK_ALERT_CHANNEL_ID are set, sends are logged
# SKIPPED in the delivery log — never silent.
#
#   SLACK_BOT_TOKEN=              # xoxb-… bot token (chat:write + channel scope)
#   SLACK_ALERT_CHANNEL_ID=       # destination channel id (C…) — bot must be a member
#   SLACK_SIGNING_SECRET=         # verifies Events API + /quorum slash command
#
# Events URL: ${origin}/api/slack/events · Slash command URL: ${origin}/api/slack/commands

# ─── Uptime alerting — who is told when the deployment breaks ───────────────
#
# `bun scripts/health-watch.ts` probes the deployed services from the outside
# and exits non-zero when either is down or degraded, which is the signal a
# Render cron job and every uptime monitor already act on. Point it at the
# running deployment, not at localhost:
#
#   QUORUM_API_URL=https://quorum-api-tgw2.onrender.com
#   QUORUM_STATIC_URL=https://quorum-static.onrender.com
#   HEALTH_ALERT_WEBHOOK=            # optional Slack/Discord/Google Chat URL
#   HEALTH_ALERT_EMAIL_TO=           # optional; sends through RESEND_API_KEY/RESEND_FROM
#   HEALTH_WATCH_STATE=.health-watch-state.json
#
# The managed database expires on a fixed date; warn before it bites:
#
#   DATABASE_EXPIRES_AT=2026-12-16
#   HEALTH_EXPIRY_WARN_DAYS=14
#
# See "Alerting" in docs/OPERATIONS.md for the schedule and the Render
# notification settings that cover a crash loop.
