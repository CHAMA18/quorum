!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# local database
/db
*.db
*.db-journal

# tool/session artifacts (never part of the product)
/tool-results/
/upload/
/logs/
/shots/

# local test screenshots & runtime artifacts (never part of the product)
/download/*.png
*.pid
.zscripts/judge-cookies.txt

# internal build log (agent work notes, never part of the product)
/worklog.md

# ...but ship the example
!.env.example

# Cloudflare Workers local state
workers/*/.wrangler/
workers/*/.dev.vars
