{
  "name": "quorum-mcp",
  "displayName": "Quorum MCP",
  "description": "Read-only Quorum procurement desk tools for VS Code chat.",
  "version": "0.1.0",
  "publisher": "chama18",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CHAMA18/the-bid-box-challenge"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onCommand:quorumMcp.configure",
    "onCommand:quorumMcp.checkConnection"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quorumMcp.configure",
        "title": "Quorum MCP: Configure Read-only Server"
      },
      {
        "command": "quorumMcp.checkConnection",
        "title": "Quorum MCP: Check Local Connection"
      }
    ],
    "configuration": {
      "title": "Quorum MCP",
      "properties": {
        "quorumMcp.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3031",
          "description": "Local Quorum MCP sidecar URL. Only loopback URLs on port 3031 are accepted."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0"
  }
}
